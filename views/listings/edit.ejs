<% layout("/layouts/boilerplate.ejs") %>
<body>
  <div class="row new-form">
    <div class="col-8 offset-2">
      <h1>Edit details required:</h1>
      <form
        method="post"
        action="/listings/<%= listing._id %>?_method=PUT"
        class="needs-validation"
        novalidate
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-label">Edit The title</label>
          <input
            type="text"
            name="title"
            class="form-control"
            value="<%= listing.title%>"
            required
          />
          <div class="invalid-feedback">Please choose a username.</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description:</label
          ><textarea
            class="form-control"
            name="description"
            id=""
            row="10"
            col="20"
          >
<%= listing.description %></textarea
          >
          <div class="invalid-feedback">Please provide description</div>
        </div>
        <div class="mb-3">
          <label for="price" class="form-label">Price of the listing:</label>
          <input
            value="<%= listing.price %>"
            class="form-control"
            type="number"
            name="price"
            step="100"
            required
          />
          <div class="invalid-feedback">Enter a valid price</div>
        </div>
        <div>
          Existing image:
          <img src="<%= originalImageUrl %>" />
        </div>
        <div class="mb-3">
          <label for="image" class="form-label">Upload new image:</label>
          <input type="file" name="image" class="form-control" />
        </div>
        <div class="mb-3">
          <label for="location" class="form-label">Location:</label
          ><input
            class="form-control"
            type="text"
            name="location"
            value="<%= listing.location %>"
          />
          <div class="invalid-feedback">Please enter the location</div>
        </div>
        <div class="mb-3">
          <label for="country" class="form-label">Country:</label>
          <input
            class="form-control"
            type="text"
            name="country"
            value="<%= listing.country %>"
          />
          <div class="invalid-feedback">Please enter the country</div>
        </div>
         <div class="mb-3">
          <label for="tax" class="form-label">Update new tax</label>
          <input
            class="form-control"
            type="number"
            name="tax"
            value="<%= listing.tax %>"
          />
          
        </div>
         <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select name="category" class="form-control" id="" value="<%= listing.category %>">
            <option value="mountain">Mountain</option>
            <option value="boat">Boat</option>
            <option value="arctic">Arctic</option>
            <option value="beach">Beach</option>
            <option value="room">Room</option>
            <option value="castle">Castle</option>
            <option value="pool">Pool</option>
            <option value="farm">Farm</option>
            <option value="camp">Camp</option>
            <option value="dome">Dome</option>
            <option value="city">City</option>
          </select>
        </div>
        <button class="add-btn">Update</button>
      </form>
    </div>
  </div>
</body>
